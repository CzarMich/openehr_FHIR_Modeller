# Optional browser client. The MCP server works without it.
CHAT_ENABLED=false
CHAT_PUBLIC_URL=https://modelling.example.org
CHAT_OIDC_ISSUER=https://identity.example.org/realms/organisation
CHAT_OIDC_CLIENT_ID=openehr-modelling-browser
CHAT_OIDC_CLIENT_SECRET=
# Optional native local accounts. Store the 64-character key in a protected environment file/secret manager.
CHAT_LOCAL_IDENTITY_ENABLED=false
CHAT_LOCAL_IDENTITY_ISSUER=https://modelling.example.org/identity/local
CHAT_LOCAL_IDENTITY_ENCRYPTION_KEY=
# Restrict to signed ID-token groups if required; empty admits this issuer's users.
CHAT_ALLOWED_GROUPS=
CHAT_MCP_URL=http://ingress:8343/mcp
CHAT_MCP_API_KEY=
CHAT_MCP_API_KEY_HEADER=X-API-Key
CHAT_ALLOW_WRITES=false
# User provider connections are encrypted with a dedicated, backed-up key.
# Generate once: openssl rand -hex 32
CHAT_PROVIDER_ENCRYPTION_KEY=
CHAT_MODEL=gpt-6-sol
CHAT_CLAUDE_MODEL=claude-sonnet-5-5
CHAT_TURN_TIMEOUT_SECONDS=240
# Approximate token budgets. Includes a separate 8,192-token execution reserve.
CHAT_CONTEXT_INPUT_TOKENS=12000
CHAT_CONTEXT_HISTORY_TOKENS=2000
CHAT_TOOL_RESULT_TOKENS=4000
CHAT_CONTEXT_SESSION_TOKENS=48000
CHAT_SESSION_MAX_TURNS=8
CHAT_SESSION_IDLE_SECONDS=1800
# Container defaults. Do not use repository directories for chat or credential storage.
CHAT_DATA_DIR=/data/chat
CHAT_CODEX_WORK_DIR=/workspace
CHAT_CODEX_BINARY=codex
CHAT_PORT=8350
# Exact internal HTTPS hostnames users may contact with personal CKM/GitLab connections.
# Public HTTPS hosts work by default; private/link-local/loopback addresses are blocked.
CHAT_PERSONAL_ALLOWED_HOSTS=

# Independent human review works with CHAT_ENABLED=false and no Codex credential.
CHAT_REVIEW_ENABLED=false
CHAT_REVIEW_SIGNING_KEY=
CHAT_REVIEW_KEY_ID=active
CHAT_REVIEW_ROLES_CLAIM=roles
CHAT_REVIEW_TENANT_CLAIM=
CHAT_REVIEW_PROJECT_SCOPES_CLAIM=project_scopes
CHAT_REVIEW_SESSION_MAX_AGE=900

# AQL workspace uses browser identity and request signing, independently of conversational chat.
CHAT_CDR_ENABLED=false

# Local-only defaults. For enterprise HTTP set APP_ENV=production and AUTH_MODE=api_key.
APP_ENV=development
PRODUCT_NAME="openEHR Modelling Assistant"
PRODUCT_SHORT_NAME="openEHR Modelling Assistant"
PRODUCT_VENDOR="Michael Anywar"
PRODUCT_DESCRIPTION="AI-assisted openEHR modelling and knowledge services"
PRODUCT_URL=
PRODUCT_SUPPORT_URL=
PRODUCT_DOCUMENTATION_URL=
PRODUCT_LOGO_URL=
MCP_SERVER_NAME=openehr-modelling-assistant
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8343
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=
AUTH_MODE=none
AUTH_API_KEY=
AUTH_API_KEY_HEADER=X-API-Key
# Native HTTP bearer verification; see docs/OIDC.md before migrating existing clients/data.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLOCK_SKEW=60
OIDC_MAX_TOKEN_AGE=7200
OIDC_ALLOWED_CLIENT_IDS=
OIDC_REQUIRED_SCOPES=modelling.read
OIDC_ROLES_CLAIM=roles
OIDC_REQUIRED_ROLES=
OIDC_WRITE_ROLES=modeller,administrator
PROJECT_RBAC_ENABLED=false
OIDC_TENANT_CLAIM=
OIDC_ALLOWED_TENANTS=
OIDC_TENANT_GIT_REMOTES='{}'
CKM_API_BASE_URL=https://ckm.openehr.org/ckm/rest/
CKM_TIMEOUT=15
# Add any CKM offering the same REST contract; URLs are administrator configuration.
CKM_SOURCES='{}'
CKM_DEFAULT_SOURCE=default
# Per-source credentials are private deployment configuration; prefer mounted secret_file profiles.
CKM_AUTH='{}'
CKM_FEDERATION_TIMEOUT=30
TERMINOLOGY_FHIR_BASE_URL=
TERMINOLOGY_BEARER_TOKEN=
TERMINOLOGY_API_KEY=
TERMINOLOGY_API_KEY_HEADER=X-API-Key
# Standard FHIR is url. Use system only for a verified legacy server (see TERMINOLOGY.md).
TERMINOLOGY_CODESYSTEM_VALIDATE_PARAMETER=url
HTTP_TIMEOUT=15
HTTP_SSL_VERIFY=true
HTTP_CA_BUNDLE=
MAX_REQUEST_BYTES=2097152
MAX_UPSTREAM_BYTES=8388608
LOG_LEVEL=info
MODEL_REPOSITORY_PROVIDER=filesystem
# Container path is /data/models, backed by the compose models volume.
MODEL_REPOSITORY_PATH=/data/models
MODEL_REPOSITORY_WRITE_ENABLED=false
# Git is optional. An empty remote keeps Git history entirely local.
MODEL_GIT_REMOTE_URL=
MODEL_GIT_BRANCH=main
MODEL_GIT_REVIEW_TARGET=main
# Optional github/gitlab API capabilities; keep tokens in private deployment configuration.
MODEL_HOSTED_API_URL=
MODEL_HOSTED_TOKEN=
MODEL_GIT_SYNC_SECONDS=5
MODEL_GIT_TIMEOUT=30
MODEL_GIT_AUTHOR_NAME="openEHR Modelling Assistant"
MODEL_GIT_AUTHOR_EMAIL=modelling-assistant@localhost
MODEL_GIT_SSH_KEY_FILE=
MODEL_GIT_KNOWN_HOSTS_FILE=
# Model files may be nested under local/ in an authoring repository.
MODEL_GIT_CONTENT_PATH=
# categories: templates/name.t.json; flat: name.t.json (logical MCP path stays templates/name.t.json).
MODEL_GIT_LAYOUT=categories

# Optional SharePoint repository; see docs/SHAREPOINT_REPOSITORY.md for provisioning.
SHAREPOINT_GRAPH_URL=https://graph.microsoft.com/v1.0/
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
SHAREPOINT_DOWNLOAD_HOSTS=
SHAREPOINT_MAX_PROJECT_BYTES=8388608
SHAREPOINT_ACCESS_TOKEN=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TOKEN_URL=
SHAREPOINT_TOKEN_SCOPE=https://graph.microsoft.com/.default
OIDC_TENANT_SHAREPOINT_REPOSITORIES='{}'

# Persisted review/audit. Store the ledger separately from editable model files.
GOVERNANCE_ENABLED=false
# Production/shared deployments: include deploy/compose.storage.yml (see docs/POSTGRES_AND_CACHE.md).
GOVERNANCE_DATABASE_DRIVER=sqlite
GOVERNANCE_DATABASE_PATH=/data/governance/audit.sqlite
GOVERNANCE_POSTGRES_DSN=
GOVERNANCE_POSTGRES_USER=modelling_app
GOVERNANCE_POSTGRES_PASSWORD_FILE=
MODEL_CACHE_DRIVER=none
MODEL_CACHE_URL=redis://cache:6379/0
MODEL_CACHE_PASSWORD_FILE=
MODEL_CACHE_SIGNING_KEY_FILE=
MODEL_CACHE_TTL=300
MODEL_CACHE_NAMESPACE=openehr-models-v1
GOVERNANCE_BROWSER_ORIGIN=
GOVERNANCE_OIDC_ISSUER=
GOVERNANCE_BROWSER_KEYS='{}'
GOVERNANCE_SESSION_MAX_AGE=900
GOVERNANCE_BROWSER_SESSION_MAX_AGE=3600
GOVERNANCE_ROLE_MAP='{"modeller":["modelling-modeller","modelling-administrator"],"reviewer":["modelling-reviewer","modelling-administrator"],"approver":["modelling-approver","modelling-administrator"],"publisher":["modelling-publisher","modelling-administrator"]}'
# reviews: no model-provider runtime; chat: include the optional conversational adapter.
MODELLING_BROWSER_TARGET=reviews

# Optional native ADL 2 / OPT 2 and AQL engine; see docs/OPT_COMPILATION.md.
OPENEHR_ENGINE_URL=
OPENEHR_ENGINE_KEY_FILE=
OPENEHR_ENGINE_TIMEOUT=50
# MODELLING_ENGINE_KEY_FILE=/absolute/private/engine-key (Compose overlay input)

# Optional CDR client; encrypted profiles live separately from models and results are not stored.
CDR_ENABLED=false
CDR_DATA_DIR=/data/cdr
CDR_ENCRYPTION_KEY_FILE=
CDR_CONNECTIONS_FILE=
CDR_ALLOWED_HOSTS=
CDR_ALLOW_HTTP=false

{
  "openapi": "3.1.0",
  "info": {
    "title": "openEHR Modelling Assistant human review API",
    "version": "1.0.0",
    "description": "Internal browser-backend contract. Requires a dedicated short-lived interactive-review assertion; ordinary MCP credentials cannot approve models. Publication requires qualified validation."
  },
  "servers": [
    {
      "url": "https://modelling.example.org"
    }
  ],
  "security": [
    {
      "InteractiveReviewAssertion": []
    }
  ],
  "paths": {
    "/api/v1/reviews": {
      "get": {
        "operationId": "listModelReviews",
        "summary": "List project review subjects in the authenticated tenant",
        "parameters": [
          {
            "in": "query",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "count",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result with authoritative exact-revision evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed input contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Interactive assertion absent, invalid or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role, origin, human-independence, validation or write policy rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Review subject not found in this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Source or audit sequence changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Governance is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds deployment limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON media type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Redacted storage or validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reviews/{subject}": {
      "get": {
        "operationId": "getModelReview",
        "summary": "Read exact source, lifecycle state, validation, permitted actions and audit history",
        "parameters": [
          {
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result with authoritative exact-revision evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed input contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Interactive assertion absent, invalid or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role, origin, human-independence, validation or write policy rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Review subject not found in this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Source or audit sequence changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Governance is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds deployment limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON media type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Redacted storage or validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reviews/{subject}/transitions": {
      "post": {
        "operationId": "recordHumanModelDecision",
        "summary": "Record an explicit authenticated decision on the exact review revision",
        "parameters": [
          {
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result with authoritative exact-revision evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed input contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Interactive assertion absent, invalid or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role, origin, human-independence, validation or write policy rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Review subject not found in this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Source or audit sequence changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Governance is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds deployment limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON media type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Redacted storage or validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InteractiveReviewAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "openehr-review+jwt",
        "description": "Dedicated HS256 assertion issued only by the authenticated browser backend, bound to method, exact request target, body SHA-256 and single-use nonce. See docs/GOVERNANCE.md. This is not a normal OIDC access token."
      }
    },
    "schemas": {
      "ReviewDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "expectedSequence",
          "comment"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "REVIEW_REQUESTED",
              "REVIEWED",
              "CHANGES_REQUESTED",
              "APPROVED",
              "PUBLISHED",
              "DEPRECATED"
            ]
          },
          "expectedSequence": {
            "type": "integer",
            "minimum": 1
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "validationDigest": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact stored validation digest required for approval/publication."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "State": {
        "type": "string",
        "enum": [
          "DRAFT",
          "VALIDATED",
          "REVIEW_REQUESTED",
          "REVIEWED",
          "CHANGES_REQUESTED",
          "APPROVED",
          "PUBLISHED",
          "DEPRECATED"
        ]
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "path",
          "revision",
          "sha256"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "Actor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenant",
          "roles",
          "human",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human": {
            "type": "boolean"
          },
          "method": {
            "type": "string"
          }
        }
      },
      "Validation": {
        "type": [
          "object",
          "null"
        ],
        "description": "Installed validation executor evidence. The report cannot be supplied by this API. Stage-specific result details may be added.",
        "required": [
          "status",
          "release_eligible",
          "content_sha256",
          "steps"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "release_eligible": {
            "type": "boolean"
          },
          "content_sha256": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant",
          "subject",
          "sequence",
          "timestamp",
          "previous_hash",
          "hash",
          "type",
          "project",
          "actor",
          "previous_state",
          "new_state",
          "comment"
        ],
        "properties": {
          "tenant": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string"
          },
          "previous_hash": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "REGISTER",
              "VALIDATION",
              "TRANSITION"
            ]
          },
          "project": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "author": {
            "type": "string"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "previous_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_state": {
            "$ref": "#/components/schemas/State"
          },
          "comment": {
            "type": "string"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          },
          "validation_digest": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "sequence",
          "state",
          "author",
          "source",
          "validation",
          "validation_digest",
          "events",
          "clinical_approval",
          "current_source",
          "approval_scope",
          "available_transitions"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "author": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          },
          "validation_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "clinical_approval": {
            "type": "boolean"
          },
          "current_source": {
            "type": "boolean"
          },
          "approval_scope": {
            "type": "string"
          },
          "available_transitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/State"
            }
          },
          "content": {
            "type": "string"
          }
        }
      },
      "ReviewList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "offset",
          "count",
          "has_more_possible"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject",
                "sequence",
                "state",
                "source",
                "author",
                "updated_at"
              ],
              "properties": {
                "subject": {
                  "type": "string"
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "$ref": "#/components/schemas/State"
                },
                "source": {
                  "$ref": "#/components/schemas/Source"
                },
                "author": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string"
                }
              }
            }
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "has_more_possible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

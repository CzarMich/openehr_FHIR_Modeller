{
    "name": "openehr/modelling-assistant",
    "description": "openEHR Modelling Assistant, independently maintained and developed by Michael Anywar.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Anywar",
            "role": "Owner and maintainer of the current product"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "ext-pdo_sqlite": "*",
        "ext-redis": "*",
        "ext-simplexml": "*",
        "firebase/php-jwt": "^7.2",
        "guzzlehttp/guzzle": "^7.9",
        "mcp/sdk": "^0.8.1",
        "monolog/monolog": "^3.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^8.0",
        "symfony/finder": "^7.3 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.3",
        "roave/security-advisories": "dev-latest",
        "symfony/yaml": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "OpenEHR\\Assistant\\": "src/"
        },
        "files": [
            "src/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenEHR\\Assistant\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off vendor/bin/phpunit --configuration tests/phpunit.xml --no-coverage --display-deprecations --display-notices --display-warnings",
        "test:dox": "@test --testdox",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration tests/phpunit.xml --coverage-html var/phpunit/code-coverage --coverage-text=php://stdout",
        "check:phpstan": "XDEBUG_MODE=off vendor/bin/phpstan analyse --configuration tests/phpstan.neon --memory-limit 2G",
        "check:phpstan-baseline": "@phpstan --generate-baseline tests/phpstan-baseline.neon",
        "check:spec": "XDEBUG_MODE=off php scripts/spec-check.php",
        "model": "php scripts/model.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true,
            "roave/security-advisories": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
